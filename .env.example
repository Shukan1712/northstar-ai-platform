# The application works in deterministic demo mode while these are blank.
# Add your provider settings to enable model-generated answers and semantic search.
OPENAI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local application settings. You normally do not need to change these.
APP_SECRET=local-northstar-demo-secret-change-before-public-deployment
DATABASE_URL=postgresql+psycopg://northstar:northstar@db:5432/northstar
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
AI_MAX_TOOL_ROUNDS=4
AI_DAILY_USER_QUOTA=15
AI_DAILY_GLOBAL_QUOTA=75
